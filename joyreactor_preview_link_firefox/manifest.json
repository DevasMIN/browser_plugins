{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "browser_specific_settings": {
    "gecko": {
      "id": "joyreactor-mp4@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": ["https://joy.reactor.cc/*", "*://joyreactor.cc/*", "*://*.joyreactor.cc/*", "*://reactor.cc/*", "*://*.reactor.cc/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png",
      "128": "icons/noautoplay_128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://joy.reactor.cc/*", "*://joyreactor.cc/*", "*://*.joyreactor.cc/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "128": "icons/noautoplay_128x128.png"
  }
}

