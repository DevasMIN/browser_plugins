{
  "manifest_version": 3,
  "name": "YouTube Deep Feed",
  "version": "0.9.27",
  "description": "\u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u0430\u044f \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043b\u0435\u043d\u0442\u0430 \u043f\u043e \u0432\u0441\u0435\u043c \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430\u043c: \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u044d\u0448, \u0441\u043a\u0440\u044b\u0442\u0438\u0435 \u0432\u0438\u0434\u0435\u043e/\u043a\u0430\u043d\u0430\u043b\u043e\u0432, \u0430\u0432\u0442\u043e\u043e\u0442\u043c\u0435\u0442\u043a\u0430 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 YouTube",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-deep-feed@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "description": "This extension does not collect or transmit user data."
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043b\u0435\u043d\u0442\u0443 \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u043a"
  },
  "commands": {
    "open-feed": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0433\u043b\u0443\u0431\u043e\u043a\u0443\u044e \u043b\u0435\u043d\u0442\u0443 \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u043a"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "feed.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}